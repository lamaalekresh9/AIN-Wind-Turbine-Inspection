# Copy this file to .env and fill in the values.
SECRET_KEY=replace-with-a-long-random-string

# AI keys (the provider and models are chosen in app.py)
# OpenAI key: https://platform.openai.com/api-keys  (the account needs billing / credit)
OPENAI_API_KEY=
# Optional free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Video sampling and duplicate merging
DEFAULT_FRAME_INTERVAL=1.0
MAX_FRAMES_PER_VIDEO=300
DEDUP_IOU=0.3
DEDUP_CENTER_DIST=0.06
DEDUP_MAX_GAP=2

MAX_UPLOAD_MB=500
ALLOW_SIGNUP=true
SEED_DEMO_DATA=true
